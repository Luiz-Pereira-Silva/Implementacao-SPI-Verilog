module RegistradorPISO (input wire       clk, clr_n, load, shift, serial_in, 
								input wire [7:0] parallel_in, 
								output reg       serial_out);
	reg [7:0] registrador;
	always @(posedge clk or negedge clr_n) begin
		if (clr_n == 0) begin
			registrador <= 8'h0;
		end else begin
			if (load) begin
				registrador <= parallel_in;
			end
			else begin
				if (shift) begin
					registrador <= {registrador[6:0], 1'h0};
				end
			end
		end
		serial_out <= registrador[7];
	end
endmodule